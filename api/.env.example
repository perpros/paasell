# This is an example .env file.
# Copy this to .env and fill in your actual values for local development.
# DO NOT COMMIT .env TO VERSION CONTROL.

# FastAPI application settings
PROJECT_NAME="B2B2C Wholesale Platform API - Dev"

# Database connection
POSTGRES_SERVER=db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydatabase
# Alternatively, you can set the full DATABASE_URL:
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/mydatabase

# JWT Secret Key - Generate a strong key for production
# You can generate one using: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_here_for_local_dev

# CORS Origins (comma-separated list of allowed origins)
# Example: BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
BACKEND_CORS_ORIGINS="http://localhost:5173"

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60 # 1 hour for dev, can be longer for prod. Default in config is 7 days.
