# This is an example .env file for the frontend.
# Copy this to .env and fill in your actual values for local development.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Base URL for API calls. This is used by api.js (Axios instance)
# In development, Vite's proxy will handle requests to this path.
# In production, this should be the actual path to your backend API.
VITE_API_BASE_URL=/api/v1

# Vite Dev Server Proxy Settings (Optional - defaults are in vite.config.js)
# Prefix for API calls that should be proxied
# VITE_API_PROXY_PREFIX=/api/v1
# Target for the proxy (backend service name if using Docker, or localhost:port)
# VITE_API_PROXY_TARGET=http://backend:8000
# VITE_API_PROXY_TARGET=http://localhost:8000 # if running backend locally without docker on port 8000
